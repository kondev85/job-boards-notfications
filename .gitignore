__pycache__/
*.pyc

# Scraper outputs are denied by default, but the board registry and its resumable
# provider-validation checkpoint are intentionally accessible project artifacts.
#
# boards.json in particular: a full --refresh-boards crawl discovers ~3,400 slugs,
# which is effectively Ashby's customer list. Committing it would turn a scraping
# tool into published competitive intelligence.
*.csv
*.json
!boards.seed.json
!boards.json
!provider-registry-progress.json
!package.json
!package-lock.json
!tsconfig.json

# Web build outputs and installed dependencies.
node_modules/
dist/
screenshots/

# Scrape database.
*.db
*.db-journal

# OpenWiki scratch: a per-run planning file, not documentation.
openwiki/_plan.md
