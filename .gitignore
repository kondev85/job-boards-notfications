__pycache__/
*.pyc

# Nothing this tool writes belongs in the repo, and --out lets you name the output
# anything, so deny by default and allow the one file that is genuinely source.
#
# boards.json in particular: a full --refresh-boards crawl discovers ~3,400 slugs,
# which is effectively Ashby's customer list. Committing it would turn a scraping
# tool into published competitive intelligence.
*.csv
*.json
!boards.seed.json
!package.json
!package-lock.json
!tsconfig.json

# Web build outputs and installed dependencies.
node_modules/
dist/
screenshots/

# Scrape database.
*.db
*.db-journal

# OpenWiki scratch: a per-run planning file, not documentation.
openwiki/_plan.md
